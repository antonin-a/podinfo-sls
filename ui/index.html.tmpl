<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{if .Refresh}}<meta http-equiv="refresh" content="2">{{end}}
  <title>podinfo-sls {{.RevisionLabel}}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
  <style>
    :root { --band: {{.Color}}; --band-text: {{.TextColor}}; }
  </style>
</head>
<body>
  <header class="band">
    <div class="wrap">
      <div class="brand">
        {{if .Logo}}<img class="logo" src="{{.Logo}}" alt="logo">{{else}}<span class="wordmark">podinfo-sls</span>{{end}}
      </div>
      <h1 class="message">{{.Message}}</h1>
      <div class="chips">
        <span class="chip">version <strong>{{.Version}}</strong></span>
        <span class="chip">revision <strong>{{.RevisionLabel}}</strong></span>
        <span class="chip">colour <strong>{{.Color}}</strong></span>
        {{if .ColdStart}}<span class="chip cold">cold start</span>{{end}}
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="toolbar">
      <button id="refresh-toggle" class="btn" type="button">
        {{if .Refresh}}Stop auto-refresh{{else}}Auto-refresh every 2s{{end}}
      </button>
      <a class="btn ghost" href="/api/info">/api/info</a>
      <a class="btn ghost" href="/api/env">/api/env</a>
      <a class="btn ghost" href="/events">/events</a>
    </div>

    <section class="cards">
      <article class="card">
        <h2>Instance{{if .ColdStart}} <span class="badge">cold start</span>{{end}}</h2>
        <dl>
          <dt>hostname</dt><dd class="mono">{{.Hostname}}</dd>
          <dt>instanceId</dt><dd class="mono big">{{.InstanceID}}</dd>
          <dt>startedAt</dt><dd class="mono">{{.StartedAt}}</dd>
          <dt>uptime</dt><dd>{{.UptimeHuman}}</dd>
          <dt>requestsServed</dt><dd>{{.Requests}}</dd>
        </dl>
      </article>

      <article class="card">
        <h2>Runtime</h2>
        <dl>
          <dt>platform</dt><dd class="mono">{{.GOOS}}/{{.GOARCH}}</dd>
          <dt>go</dt><dd class="mono">{{.GoVersion}}</dd>
          <dt>NumCPU</dt><dd>{{.NumCPU}}</dd>
          <dt>PORT</dt><dd class="mono">{{.Port}}</dd>
          <dt>events</dt><dd>{{if .FailEvents}}<span class="warn">failing on purpose</span>{{else}}accepting{{end}}</dd>
        </dl>
      </article>
    </section>

    <section class="cards">
      <article class="card" id="timing" data-cold="{{if .ColdStart}}1{{else}}0{{end}}">
        <h2>Response time <span class="hint">measured by your browser</span></h2>
        <p class="headline" id="t-headline">measuring...</p>
        <dl>
          <dt>waiting for first byte</dt><dd><span class="big-num" id="t-ttfb">-</span></dd>
          <dt>of which application</dt><dd class="mono" id="t-app">-</dd>
          <dt>of which platform + network</dt><dd class="mono" id="t-platform">-</dd>
          <dt>DNS + TLS connection</dt><dd class="mono" id="t-connect">-</dd>
        </dl>
        <div class="estimate" id="t-estimate" hidden>
          <div class="estimate-label">estimated platform cold start</div>
          <div class="estimate-value" id="t-est-value">-</div>
          <div class="estimate-sub" id="t-est-sub"></div>
        </div>
        <div class="measure">
          <button id="t-run" class="btn" type="button">Measure 5 calls</button>
          <ol id="t-list" class="mono"></ol>
        </div>
      </article>

      <article class="card">
        <h2>Instance startup <span class="hint">measured by the instance</span></h2>
        <ol class="timeline">
          <li><span class="step">VM boot to process start</span>
            <span class="val">{{if .Startup.DedicatedKernel}}{{with .Startup.KernelBootToProcessMs}}{{.}} ms{{end}}{{else}}<span class="muted">shared kernel, not measurable</span>{{end}}</span></li>
          <li><span class="step">process start to ready</span>
            <span class="val">{{with .Startup.ProcessToReadyMs}}{{.}} ms{{else}}-{{end}}</span></li>
          {{if .Startup.StartedAheadOfTraffic}}
          <li class="aside"><span class="step">started before any traffic: first request came later</span>
            <span class="val muted">{{with .Startup.ReadyToFirstRequestMs}}{{.}} ms{{end}}</span></li>
          {{else}}
          <li><span class="step">ready to first request</span>
            <span class="val">{{with .Startup.ReadyToFirstRequestMs}}{{.}} ms{{else}}-{{end}}</span></li>
          {{end}}
          <li class="total"><span class="step">{{if .Startup.StartedAheadOfTraffic}}instance startup time (nobody was waiting){{else}}cold start seen from inside the instance{{end}}</span>
            <span class="val">{{with .Startup.InstanceColdStartMs}}{{.}} ms{{else}}-{{end}}</span></li>
        </ol>
        <p class="note">{{if .Startup.StartedAheadOfTraffic}}This instance was started before any request was waiting (at deploy, or to keep capacity): the wait for the first visitor is idle time, not part of a cold start. {{end}}The platform's own figure, from wake to the application answering, is the cold start in the Metrics tab of the console (Serverless API metrics). The first line exists only when the instance runs its own kernel (micro-VM).</p>
      </article>
    </section>

    <section class="card endpoints">
      <h2>Endpoints</h2>
      <ul class="mono">
        <li><code>GET /api/info</code> instance and revision metadata</li>
        <li><code>GET /api/env</code> SLS_* variables, secrets masked</li>
        <li><code>GET /healthz</code> <code>GET /readyz</code> <code>POST /readyz/disable|enable</code></li>
        <li><code>GET /delay/{s}</code> <code>GET /status/{code}</code> <code>GET /panic</code></li>
        <li><code>GET /burn/cpu?s=N</code> <code>GET /burn/mem?mb=N</code> <code>GET /burn/mem/release</code></li>
        <li><code>GET /stream?s=N</code> Server-Sent Events</li>
        <li><code>POST /events</code> CloudEvents receiver, <code>GET /events</code> last 20</li>
      </ul>
    </section>
  </main>

  <footer class="wrap foot">
    <span>podinfo-sls {{.Version}}, inspired by <a href="https://github.com/stefanprodan/podinfo">podinfo</a></span>
    <span class="mono">{{.InstanceID}} on {{.Hostname}}</span>
  </footer>

  <script>
    (function () {
      var btn = document.getElementById('refresh-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var url = new URL(window.location.href);
        if (url.searchParams.get('refresh') === '1') {
          url.searchParams.delete('refresh');
        } else {
          url.searchParams.set('refresh', '1');
        }
        window.location.replace(url.toString());
      });
    })();
  </script>
  <script>
    (function () {
      function fmt(v) { return v == null ? '-' : (v < 10 ? v.toFixed(1) : Math.round(v)) + ' ms'; }
      function appDur(entry) {
        var st = (entry && entry.serverTiming) || [];
        for (var i = 0; i < st.length; i++) if (st[i].name === 'app') return st[i].duration;
        return null;
      }
      var cold = document.getElementById('timing').dataset.cold === '1';
      function showNav() {
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (!nav || !nav.responseStart) { document.getElementById('t-headline').textContent = 'not available in this browser'; return; }
        var ttfb = nav.responseStart - nav.requestStart;
        var app = appDur(nav);
        var connect = nav.connectEnd > 0 ? nav.connectEnd - nav.domainLookupStart : null;
        document.getElementById('t-ttfb').textContent = fmt(ttfb);
        document.getElementById('t-app').textContent = fmt(app);
        document.getElementById('t-platform').textContent = app == null ? '-' : fmt(Math.max(0, ttfb - app));
        document.getElementById('t-connect').textContent = connect && connect > 0 ? fmt(connect) : 'reused';
        document.getElementById('t-headline').innerHTML = cold
          ? '<span class="cold-tag">cold start</span> this page woke the instance: you waited <strong>' + fmt(ttfb) + '</strong>'
          : 'warm instance: you waited <strong>' + fmt(ttfb) + '</strong>';
        if (cold) estimate(ttfb);
      }

      // A cold page minus a warm call made right after: network and
      // application time cancel out, what is left is the platform's wake.
      function estimate(coldTtfb) {
        var url = '/api/info?warm=' + Date.now();
        fetch(url, { cache: 'no-store' }).then(function (r) { return r.text(); }).then(function () {
          var e = performance.getEntriesByName(new URL(url, location.href).href)[0];
          if (!e || !e.responseStart) return;
          var warm = e.responseStart - e.requestStart;
          document.getElementById('t-estimate').hidden = false;
          document.getElementById('t-est-value').textContent = fmt(Math.max(0, coldTtfb - warm));
          document.getElementById('t-est-sub').textContent = 'this page (' + fmt(coldTtfb) + ') minus a warm call made right after (' + fmt(warm) + '): network and application cancel out';
        }).catch(function () {});
      }
      if (document.readyState === 'complete') showNav(); else window.addEventListener('load', function () { setTimeout(showNav, 0); });

      var run = document.getElementById('t-run'), list = document.getElementById('t-list');
      run.addEventListener('click', function () {
        run.disabled = true; list.innerHTML = '';
        var i = 0;
        (function next() {
          if (i >= 5) { run.disabled = false; return; }
          var url = '/api/info?probe=' + Date.now() + '-' + i, t0 = performance.now();
          fetch(url, { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (j) {
            var total = performance.now() - t0;
            var e = performance.getEntriesByName(new URL(url, location.href).href)[0];
            var li = document.createElement('li');
            li.textContent = fmt(total) + '  (app ' + fmt(appDur(e)) + ', instance ' + j.instanceId + (j.coldStart ? ', cold start' : '') + ')';
            list.appendChild(li);
          }).catch(function () {
            var li = document.createElement('li'); li.textContent = 'error'; list.appendChild(li);
          }).then(function () { i++; next(); });
        })();
      });
    })();
  </script>
</body>
</html>
